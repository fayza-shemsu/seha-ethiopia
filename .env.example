# Resource Group
AZURE_SUBSCRIPTION_ID=your_subscription_id_here
AZURE_RESOURCE_GROUP=your_resource_group_here

# Azure ML
AZURE_ML_WORKSPACE=your_ml_workspace_here

# Azure OpenAI
AZURE_OPENAI_KEY=your_openai_key_here
AZURE_OPENAI_ENDPOINT=your_openai_endpoint_here
AZURE_CHAT_DEPLOYMENT=o4-mini
AZURE_EMBEDDING_ENDPOINT=your_embedding_endpoint_here
AZURE_EMBEDDING_KEY=your_embedding_key_here
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_storage_connection_string_here
AZURE_STORAGE_CONTAINER=health-documents

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=your_document_intelligence_endpoint_here
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_key_here

# Azure AI Search
AZURE_SEARCH_ENDPOINT=your_search_endpoint_here
AZURE_SEARCH_KEY=your_search_key_here
AZURE_SEARCH_INDEX=seha-health-index

# Groq
GROQ_API_KEY=your_groq_api_key_here
